[Unit]
Description=Bot InfoLoker Karawang Auto Apply
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bot-infolokerkarawang
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/bot-infolokerkarawang/.venv/bin/python -u /home/ubuntu/bot-infolokerkarawang/auto_apply.py
Restart=always
RestartSec=10
SyslogIdentifier=bot-infoloker

[Install]
WantedBy=multi-user.target
